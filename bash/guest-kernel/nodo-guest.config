# Nodo guest kernel — architecture-independent config fragment.
#
# Merged on top of `defconfig` + the in-tree `kernel/configs/kvm_guest.config`
# by bash/guest-kernel/build.sh. Everything a service needs must be built in:
# CONFIG_MODULES is off, so the initramfs never loads anything.
#
# Keep this file as the single source of truth for what a Nodo microVM guest can
# do. Adding a feature here is a decision about every service on the network.

# --- No modules. The initramfs is busybox + /init, nothing else. ---
# CONFIG_MODULES is not set

# --- Boot: Cloud Hypervisor hands us an initramfs and a command line. ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- virtio: every device Nodo attaches to a service microVM. ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# --- Filesystems: ext4 rootfs, virtiofs shares, overlay for in-guest dockerd. ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_AUTOFS_FS=y

# --- Containers inside the guest: a service may boot its own dockerd. ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y

# --- Networking: tap/virtio-net uplink plus what dockerd needs internally. ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# --- RAID/device-mapper: unused (services use overlay2), and CONFIG_MD makes the
# --- guest spend ~0.6s benchmarking raid6 algorithms on every single boot. ---
# CONFIG_MD is not set

# --- CMA reserves 32 MiB of contiguous memory for DMA-hungry hardware that a
# --- microVM does not have. On a 64 MiB guest that is half the RAM, and the boot
# --- ends in "Kernel panic - System is deadlocked on memory". ---
# CONFIG_CMA is not set
# CONFIG_DMA_CMA is not set

# --- Filesystems a service rootfs never uses. ext4 + overlay + virtiofs is the
# --- whole contract; the rest is several MB of Image for nothing. ---
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_9P_FS is not set

# --- No terminal, keyboard or physical NIC: the console is a serial port and the
# --- only network device is virtio-net. ---
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_ETHERNET is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set

# --- Hardware we will never see in a microVM. Off: smaller Image, faster boot. ---
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WWAN is not set
# CONFIG_BT is not set
# CONFIG_INFINIBAND is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NVME_CORE is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_GPIOLIB is not set
# CONFIG_PINCTRL is not set
# CONFIG_IIO is not set
# CONFIG_STAGING is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_PROFILING is not set

# --- Build hygiene: no debug info (build time and Image size), no signing. ---
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_MODULE_SIG is not set
