# The device variant of the guest kernel (#536): vmlinuz-dev-linux-amd64. EXPERIMENTAL.
#
# Merged after nodo-guest.config and nodo-guest-x86_64.config, so it only adds what a
# service needs to drive a device that the node gives it with VFIO (a GPU): loadable
# modules, for the vendor driver that the service ships and loads itself, and the
# subsystems that those drivers build on. The service builds its modules against the
# build tree published next to this kernel (kernel-dev-build-linux-amd64.tar.xz), and
# the node tags the device with the hash of this file, so a module built for one
# kernel never meets another.
#
# Not signed: a service loads modules that it built, and the node cannot sign them.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_COMPRESS is not set
# Firmware that a driver loads from the service's own disk.
CONFIG_FW_LOADER=y
# CONFIG_FW_LOADER_USER_HELPER is not set
# The DRM core as modules, which the GPU drivers (nvidia-drm, amdgpu) need.
CONFIG_DRM=m
CONFIG_DRM_KMS_HELPER=m
CONFIG_DRM_TTM=m
# Device passthrough: the guest maps large BARs and uses MSI-X.
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
# CONFIG_HOTPLUG_PCI is not set
# What the vendor drivers expect from the kernel they load into.
CONFIG_MMU_NOTIFIER=y
CONFIG_HMM_MIRROR=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
