# Nodo guest kernel — x86_64 additions to nodo-guest.config.
#
# Target platform is Cloud Hypervisor's x86 machine: ACPI, a 8250 console and
# PCI. The artifact is a bzImage, which is what CH's bzImage loader expects.

# --- Console CH exposes on x86_64 (--serial). ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# --- Paravirtual guest plumbing. ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y
CONFIG_ACPI=y
CONFIG_PVH=y

# --- No firmware, no legacy platform hardware. ---
# CONFIG_EFI is not set
# CONFIG_X86_PLATFORM_DEVICES is not set
# CONFIG_MICROCODE is not set
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
# CONFIG_VMWARE_HYPERVISOR is not set
