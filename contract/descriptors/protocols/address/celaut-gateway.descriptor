service=celaut.Gateway
service_id=Metadata.HashTag.Hash entries, each with its hash.type; the receiver reads the one type it keys its registry by
service_id.hash_types=0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8,46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f,a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a,e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
statement.account_ref=blake2b-256 hex of UTF-8 of celaut-ledger-account:client_id or instance token
statement.digest=blake2b-256 hex of UTF-8 of ts|relayed|account_ref|hex(service_id)|hex(instance_ref)|from_seq|to_seq|movements|hex(balance.n)|head_seq|head_hash|oldest_seq|retention_days
statement.digest.hex=lowercase hex of UTF-8; empty for an empty text
statement.digest.instance_ref=hex(instance_ref); empty when instance_ref is empty
statement.digest.movements='/'.join(hash of each movement in seq order)
statement.digest.relayed=1 when relayed is true, else 0
statement.digest.service_id=hex(service_id); empty when service_id is empty
statement.genesis=blake2b-256 hex of UTF-8 of celaut-balance-genesis:account_ref
statement.instance_ref=blake2b-256 hex of UTF-8 of celaut-ledger-instance:token
statement.movement.hash=blake2b-256 hex of UTF-8 of celaut-balance-movement:prev_hash|seq~ts~hex(amount.n)~hex(balance_after.n)~hex(kind)~instance_ref~hex(detail)
statement.signature=Peer.signature_scheme over UTF-8 of payload, lowercase hex
statement.signature.payload=celaut-balance-statement:<public_key_hex>|<statement_digest>
statement.start.quote=detail.quote of movement 1 of kind start: init_maintenance_cost,max_maintenance_cost,maintenance_seconds_loop,price_bounded,price_volatility,volatility_period_seconds,on_close,closes_at and base (mem_limit,disk_space,cpu_period,cpu_quota)
tunnel.end=end of the caller's stream half-closes the service connection
tunnel.slot=decimal internal port
